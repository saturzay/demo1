# Copy this file to .env and adjust values as needed.

# --- Postgres / PostGIS ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Separate logical database (same server) used by the Prefect API backend.
PREFECT_POSTGRES_DB=prefect

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api

# --- Raw source landing (drillhole_raw_landing flow) ---
# "local" writes untouched source files under RAW_LOCAL_DIR (bind-mounted to
# ./data/raw on the host). Set to "s3" plus RAW_S3_BUCKET to upload instead;
# AWS credentials are picked up from the environment/instance role as usual.
RAW_STORAGE_BACKEND=local
RAW_LOCAL_DIR=/app/data/raw
# RAW_S3_BUCKET=
# RAW_S3_PREFIX=raw
